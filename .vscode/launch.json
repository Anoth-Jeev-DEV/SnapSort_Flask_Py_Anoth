{
  "version": "0.2.0",
  "configurations": [
    
    {
      "name": "Python Debugger: Attach using Process Id",
      "type": "debugpy",
      "request": "attach",
      "processId": "${command:pickProcess}"
    },
    {
      "name": "Python: Flask",
      "type": "debugpy",
      "request": "launch",
      "program": "C:/Users/anoth/Documents/Snapsort-PhotoSorting-Project/app.py", // Path to your main application file
      "args": [
        "run",
        "--no-debugger",
        "--no-reload"
      ], // Flask-specific arguments
      "jinja": true,
      "env": {
        "FLASK_APP": "app.py",
        "FLASK_ENV": "development"
      },
      "envFile": "C:/Users/anoth/Documents/Snapsort-PhotoSorting-Project/.env", // Path to your environment variables file
      "justMyCode": true // Optional: Skip library code during debugging
    }
  ]
}